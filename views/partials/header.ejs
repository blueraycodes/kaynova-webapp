<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title : 'Kaynova' %></title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="logo">Kaynova</a>
      <form class="search-form" action="/" method="GET">
        <input type="text" name="q" placeholder="Search products..." value="<%= typeof q !== 'undefined' ? q : '' %>" />
        <button type="submit">Search</button>
      </form>
      <div class="nav-links">
        <a href="/track">Track Order</a>
        <% if (typeof customer !== 'undefined' && customer) { %>
          <a href="/account/orders">👤 <%= customer.name || customer.phone %></a>
        <% } else { %>
          <a href="/login">Login</a>
        <% } %>
        <a href="/cart" class="cart-btn">🛒 Cart</a>
      </div>
    </div>
  </header>
  <main class="container">

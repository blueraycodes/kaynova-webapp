<% var title = (product ? 'Edit' : 'Add') + ' Product - Admin' %>
<%- include('partials/header') %>

<div class="admin-topbar">
  <h1><%= product ? 'Edit Product' : 'Add New Product' %></h1>
  <a href="/admin/products" class="btn btn-outline">Back to Products</a>
</div>

<div class="card" style="max-width:640px;">
  <form method="POST" action="<%= product ? '/admin/products/' + product.id + '/edit' : '/admin/products/new' %>" enctype="multipart/form-data">
    <div class="form-group">
      <label>Product Name</label>
      <input type="text" name="name" value="<%= product ? product.name : '' %>" required />
    </div>
    <div class="form-group">
      <label>Description</label>
      <textarea name="description" rows="3"><%= product ? product.description : '' %></textarea>
    </div>
    <div class="form-row">
      <div class="form-group">
        <label>Price (₹)</label>
        <input type="number" step="0.01" name="price" value="<%= product ? product.price : '' %>" required />
      </div>
      <div class="form-group">
        <label>Stock Quantity</label>
        <input type="number" name="stock" value="<%= product ? product.stock : 0 %>" required />
      </div>
    </div>
    <div class="form-group">
      <label>Category</label>
      <select name="category_id">
        <option value="">-- None --</option>
        <% categories.forEach(function(c) { %>
          <option value="<%= c.id %>" <%= product && product.category_id === c.id ? 'selected' : '' %>><%= c.name %></option>
        <% }); %>
      </select>
    </div>
    <div class="form-group">
      <label>Image URLs (comma-separated) or upload files below</label>
      <input type="text" name="image_url" value="<%= product ? product.image_url : '' %>" placeholder="https://... , https://..." />
    </div>
    <div class="form-group">
      <label>Or Upload Image Files (you can select multiple)</label>
      <input type="file" name="image_files" accept="image/*" multiple />
    </div>

    <% if (typeof images !== 'undefined' && images && images.length) { %>
      <div class="form-group">
        <label>Existing Images</label>
        <div style="display:flex; gap:8px; flex-wrap:wrap;">
          <% images.forEach(function(img){ %>
            <img src="<%= img.url %>" style="width:84px; height:84px; object-fit:cover; border-radius:6px; border:1px solid var(--border);" />
          <% }); %>
        </div>
        <p style="color:var(--muted); font-size:13px; margin-top:8px;">Uploading new files or adding new URLs will replace existing images.</p>
      </div>
    <% } %>
    <% if (product) { %>
      <div class="form-group">
        <label><input type="checkbox" name="active" style="width:auto; display:inline-block;" <%= product.active ? 'checked' : '' %> /> Active (visible on storefront)</label>
      </div>
    <% } %>
    <button type="submit" class="btn btn-primary btn-block"><%= product ? 'Save Changes' : 'Add Product' %></button>
  </form>
</div>

<%- include('partials/footer') %>

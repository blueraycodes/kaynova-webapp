<% var title = (product ? 'Edit' : 'Add') + ' Product - Admin' %>
<%- include('partials/header') %>

<div class="admin-topbar">
  <h1><%= product ? 'Edit Product' : 'Add New Product' %></h1>
  <a href="/admin/products" class="btn btn-outline">Back to Products</a>
</div>

<div class="card" style="max-width:640px;">
  <form method="POST" action="<%= product ? '/admin/products/' + product.id + '/edit' : '/admin/products/new' %>" enctype="multipart/form-data">
    <div class="form-group">
      <label>Product Name</label>
      <input type="text" name="name" value="<%= product ? product.name : '' %>" required />
    </div>
    <div class="form-group">
      <label>Description</label>
      <textarea name="description" rows="3"><%= product ? product.description : '' %></textarea>
    </div>
    <div class="form-row">
      <div class="form-group">
        <label>Price (₹)</label>
        <input type="number" step="0.01" name="price" value="<%= product ? product.price : '' %>" required />
      </div>
      <div class="form-group">
        <label>Stock Quantity</label>
        <input type="number" name="stock" value="<%= product ? product.stock : 0 %>" required />
      </div>
    </div>
    <div class="form-group">
      <label>Category</label>
      <select name="category_id">
        <option value="">-- None --</option>
        <% categories.forEach(function(c) { %>
          <option value="<%= c.id %>" <%= product && product.category_id === c.id ? 'selected' : '' %>><%= c.name %></option>
        <% }); %>
      </select>
    </div>
    <div class="form-group">
      <label>Image URLs (comma-separated) or upload files below</label>
      <input type="text" name="image_url" value="<%= product ? product.image_url : '' %>" placeholder="https://... , https://..." />
    </div>
    <div class="form-group">
      <label>Or Upload Image Files (you can select multiple)</label>
      <input type="file" id="imageFiles" name="image_files" accept="image/*" multiple />
      <div id="fileList" style="margin-top:8px;"></div>
    </div>

    <script>
      // Show selected files and allow entering desired filenames (without extension)
      (function(){
        const input = document.getElementById('imageFiles');
        const list = document.getElementById('fileList');
        if (!input) return;
        input.addEventListener('change', (e) => {
          list.innerHTML = '';
          Array.from(e.target.files).forEach((file, idx) => {
            const row = document.createElement('div');
            row.style.display = 'flex'; row.style.gap = '8px'; row.style.alignItems = 'center'; row.style.marginBottom = '6px';

            const thumb = document.createElement('img');
            thumb.src = URL.createObjectURL(file);
            thumb.style.width = '64px'; thumb.style.height = '64px'; thumb.style.objectFit = 'cover'; thumb.style.borderRadius='6px'; thumb.style.border='1px solid #e5e7eb';

            const nameInput = document.createElement('input');
            nameInput.type = 'text';
            nameInput.name = 'image_file_names[]';
            nameInput.value = file.name.replace(/\.[^/.]+$/, '');
            nameInput.style.flex = '1';
            nameInput.title = 'Enter desired filename (without extension)';

            const orig = document.createElement('div'); orig.textContent = file.name; orig.style.fontSize='12px'; orig.style.color='#6b7280'; orig.style.minWidth='180px';

            row.appendChild(thumb);
            row.appendChild(nameInput);
            row.appendChild(orig);
            list.appendChild(row);
          });
        });
      })();
    </script>

    <% if (typeof images !== 'undefined' && images && images.length) { %>
      <div class="form-group">
        <label>Existing Images</label>
        <div style="display:flex; gap:12px; flex-wrap:wrap;">
          <% images.forEach(function(img){ %>
            <div style="width:120px;">
              <img src="<%= img.url %>" style="width:120px; height:120px; object-fit:cover; border-radius:6px; border:1px solid var(--border); display:block;" />

              <form method="POST" action="/admin/products/<%= product.id %>/images/<%= img.id %>/rename" style="margin-top:8px; display:flex; gap:6px; align-items:center;">
                <div style="display:flex; gap:6px; align-items:center; flex:1;">
                <% if (img.url && img.url.startsWith('/uploads/')) { %>
                  <input class="image-name-input" type="text" name="name" value="<%= (function(){ var b = img.url.split('/').pop(); return b.replace(/\.[^/.]+$/, ''); })() %>" style="flex:1; font-size:12px; padding:6px;" />
                <% } else { %>
                  <input class="image-name-input" type="text" name="name" value="<%= img.url %>" style="flex:1; font-size:12px; padding:6px;" />
                <% } %>
                  <button type="button" class="clear-name-btn btn btn-sm" title="Clear filename" aria-label="Clear filename" style="padding:6px 8px;">✕</button>
                </div>
                <button type="submit" class="btn btn-outline btn-sm">Save</button>
              </form>

              <form method="POST" action="/admin/products/<%= product.id %>/images/<%= img.id %>/delete" onsubmit="return confirm('Delete this image?');" style="margin-top:6px;">
                <button type="submit" class="btn btn-danger btn-sm" style="width:100%;">Delete</button>
              </form>
            </div>
          <% }); %>
        </div>
        <p style="color:var(--muted); font-size:13px; margin-top:8px;">Uploading new files or adding new URLs will replace existing images.</p>
      </div>
    <% } %>

    <script>
      // Clear button handler for image name inputs
      document.addEventListener('click', function (e) {
        if (!e.target) return;
        if (e.target.classList && e.target.classList.contains('clear-name-btn')) {
          const wrapper = e.target.closest('div');
          if (!wrapper) return;
          const input = wrapper.querySelector('.image-name-input');
          if (input) { input.value = ''; input.focus(); }
        }
      });
    </script>    <% if (product) { %>
      <div class="form-group">
        <label><input type="checkbox" name="active" style="width:auto; display:inline-block;" <%= product.active ? 'checked' : '' %> /> Active (visible on storefront)</label>
      </div>
    <% } %>
    <button type="submit" class="btn btn-primary btn-block"><%= product ? 'Save Changes' : 'Add Product' %></button>
  </form>
</div>

<%- include('partials/footer') %>

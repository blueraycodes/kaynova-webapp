<% var title = 'Orders - Admin' %>
<%- include('partials/header') %>

<div class="admin-topbar">
  <h1>Orders & Consignment Tracking</h1>
</div>

<form method="GET" action="/admin/orders" class="filters">
  <select name="status" onchange="this.form.submit()">
    <option value="">All Statuses</option>
    <% ['placed','confirmed','packed','shipped','out_for_delivery','delivered','cancelled','returned'].forEach(function(s) { %>
      <option value="<%= s %>" <%= status === s ? 'selected' : '' %>><%= s.replace(/_/g,' ') %></option>
    <% }); %>
  </select>
  <select name="payment" onchange="this.form.submit()">
    <option value="">All Payments</option>
    <% ['pending','paid','failed','refunded'].forEach(function(s) { %>
      <option value="<%= s %>" <%= payment === s ? 'selected' : '' %>><%= s %></option>
    <% }); %>
  </select>
</form>

<table>
  <thead>
    <tr><th>Order #</th><th>Customer</th><th>Total</th><th>Payment</th><th>Status</th><th>Tracking #</th><th>Date</th><th></th></tr>
  </thead>
  <tbody>
    <% orders.forEach(function(o) { %>
      <tr>
        <td><%= o.order_number %></td>
        <td><%= o.customer_name %><br/><span style="color:#6b7280;font-size:12px;"><%= o.phone %></span></td>
        <td>₹<%= o.total_amount.toFixed(2) %></td>
        <td><span class="badge badge-<%= o.payment_status %>"><%= o.payment_status %></span></td>
        <td><span class="badge badge-<%= o.order_status %>"><%= o.order_status.replace(/_/g,' ') %></span></td>
        <td><%= o.tracking_number || '-' %></td>
        <td><%= new Date(o.created_at).toLocaleDateString() %></td>
        <td><a href="/admin/orders/<%= o.id %>" class="btn btn-outline btn-sm">Manage</a></td>
      </tr>
    <% }); %>
    <% if (orders.length === 0) { %>
      <tr><td colspan="8" style="text-align:center; color:#6b7280;">No orders found.</td></tr>
    <% } %>
  </tbody>
</table>

<%- include('partials/footer') %>

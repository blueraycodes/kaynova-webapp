<% var title = 'My Account - Kaynova' %>
<%- include('partials/header') %>

<h2 class="section-title">My Account</h2>

<div style="display:flex; gap:16px; margin-bottom:20px;">
  <a href="/account" class="btn btn-primary btn-sm">Profile</a>
  <a href="/account/orders" class="btn btn-outline btn-sm">My Orders</a>
</div>

<div class="card" style="max-width:480px;">
  <% if (saved) { %>
    <div class="alert alert-success">Profile updated successfully.</div>
  <% } %>
  <form method="POST" action="/account">
    <div class="form-group">
      <label>Mobile Number</label>
      <input type="text" value="<%= customer.phone %>" disabled />
    </div>
    <div class="form-group">
      <label>Full Name</label>
      <input type="text" name="name" value="<%= customer.name || '' %>" placeholder="Your name" />
    </div>
    <div class="form-group">
      <label>Email</label>
      <input type="email" name="email" value="<%= customer.email || '' %>" placeholder="you@example.com" />
    </div>
    <button type="submit" class="btn btn-primary btn-block">Save Changes</button>
  </form>
  <form method="POST" action="/logout" style="margin-top:14px;">
    <button type="submit" class="btn btn-outline btn-block">Logout</button>
  </form>
</div>

<%- include('partials/footer') %>

<% var title = 'Order ' + order.order_number + ' - Kaynova' %>
<%- include('partials/header') %>

<a href="/account/orders" style="font-size:13.5px;">&larr; Back to My Orders</a>

<div class="card" style="max-width:720px; margin-top:16px;">
  <div style="display:flex; justify-content:space-between; flex-wrap:wrap; gap:10px;">
    <div>
      <h3 style="margin:0 0 4px;">Order <%= order.order_number %></h3>
      <p style="margin:0; color:#6b7280; font-size:13.5px;">Placed on <%= new Date(order.created_at).toLocaleString() %></p>
    </div>
    <span class="badge badge-<%= order.order_status %>"><%= order.order_status.replace(/_/g, ' ') %></span>
  </div>

  <hr style="margin:18px 0; border:none; border-top:1px solid #e5e7eb;" />

  <div class="form-row">
    <div>
      <label>Courier</label>
      <p><%= order.courier_name || 'Not assigned yet' %></p>
    </div>
    <div>
      <label>Tracking Number</label>
      <p><%= order.tracking_number || 'Not assigned yet' %></p>
    </div>
  </div>

  <div class="form-row">
    <div>
      <label>Delivery Address</label>
      <p><%= order.address_line %>, <%= order.city %>, <%= order.state %> - <%= order.pincode %></p>
    </div>
    <div>
      <label>Payment Status</label>
      <p><span class="badge badge-<%= order.payment_status %>"><%= order.payment_status %></span></p>
    </div>
  </div>

  <h4 style="margin-top:22px;">Items</h4>
  <% items.forEach(function(it) { %>
    <div class="cart-summary"><span><%= it.product_name %> × <%= it.quantity %></span><span>₹<%= (it.price * it.quantity).toFixed(2) %></span></div>
  <% }); %>
  <div class="cart-summary total"><span>Total</span><span>₹<%= order.total_amount.toFixed(2) %></span></div>

  <h4 style="margin-top:26px;">Shipment Timeline</h4>
  <% if (timeline.length === 0) { %>
    <p style="color:#6b7280;">No updates yet. Check back soon.</p>
  <% } else { %>
    <div class="timeline">
      <% timeline.slice().reverse().forEach(function(t) { %>
        <div class="timeline-item">
          <div class="t-status"><%= t.status %></div>
          <div class="t-meta">
            <%= new Date(t.created_at).toLocaleString() %>
            <% if (t.location) { %> &middot; <%= t.location %> <% } %>
          </div>
          <% if (t.note) { %><div style="font-size:13.5px; margin-top:3px;"><%= t.note %></div><% } %>
        </div>
      <% }); %>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
